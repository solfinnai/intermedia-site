diff -ruN a/src/app/robots.ts b/src/app/robots.ts
--- a/src/app/robots.ts
+++ b/src/app/robots.ts
@@ -0,0 +1,21 @@
+import type { MetadataRoute } from "next";
+import { headers } from "next/headers";
+import { SITE_URL, isProductionHost } from "@/lib/seo";
+
+/**
+ * Host-aware robots.txt. Only www.im.agency is crawlable; every other host that
+ * reaches this deployment (*.vercel.app, preview URLs, apex before its redirect)
+ * gets Disallow: /. Reading the host makes this route dynamic, which is intended.
+ */
+export default async function robots(): Promise<MetadataRoute.Robots> {
+  const host = (await headers()).get("host");
+
+  if (!isProductionHost(host)) {
+    return { rules: { userAgent: "*", disallow: "/" } };
+  }
+
+  return {
+    rules: { userAgent: "*", allow: "/" },
+    sitemap: `${SITE_URL}/sitemap.xml`,
+  };
+}
diff -ruN a/src/app/sitemap.ts b/src/app/sitemap.ts
--- a/src/app/sitemap.ts
+++ b/src/app/sitemap.ts
@@ -0,0 +1,14 @@
+import type { MetadataRoute } from "next";
+import { INDEXABLE_ROUTES, SITE_URL } from "@/lib/seo";
+
+/**
+ * Lists only final 200 URLs on https://www.im.agency, driven by INDEXABLE_ROUTES.
+ * No lastModified: an invented date is worse than none.
+ */
+export default function sitemap(): MetadataRoute.Sitemap {
+  return INDEXABLE_ROUTES.map((path) => ({
+    url: `${SITE_URL}${path}`,
+    changeFrequency: path === "/" || path === "/insights" ? "weekly" : "monthly",
+    priority: path === "/" ? 1 : 0.7,
+  }));
+}
diff -ruN a/src/components/google-analytics.tsx b/src/components/google-analytics.tsx
--- a/src/components/google-analytics.tsx
+++ b/src/components/google-analytics.tsx
@@ -0,0 +1,34 @@
+import Script from "next/script";
+import { GA_MEASUREMENT_ID, PRODUCTION_HOST } from "@/lib/seo";
+
+// Runs in the browser. Only www.im.agency sends data to GA4. Any other host
+// (vercel.app, previews, new.im.agency) stays silent unless the URL carries
+// ?ga_test=1, which sends hits in debug mode for rehearsal checks in GA4 DebugView.
+const loader = `(function () {
+  var test = /[?&]ga_test=1(&|$)/.test(location.search);
+  if (location.hostname !== "${PRODUCTION_HOST}" && !test) return;
+  window.dataLayer = window.dataLayer || [];
+  function gtag() { dataLayer.push(arguments); }
+  window.gtag = gtag;
+  gtag("js", new Date());
+  gtag("config", "${GA_MEASUREMENT_ID}", test ? { debug_mode: true } : {});
+  var s = document.createElement("script");
+  s.async = true;
+  s.src = "https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}";
+  document.head.appendChild(s);
+})();`;
+
+/**
+ * GA4 (G-FTJBL1NS13), rendered once from the root layout so it loads a single
+ * time and persists across client navigations. GA4 enhanced measurement records
+ * App Router history changes as page views, so no manual page_view calls are
+ * needed. The measurement ID is in the server HTML on every host, so the cutover
+ * check can confirm it with curl, but the loader only runs on the production host.
+ */
+export function GoogleAnalytics() {
+  return (
+    <Script id="ga4-loader" strategy="afterInteractive">
+      {loader}
+    </Script>
+  );
+}
diff -ruN a/src/lib/seo.ts b/src/lib/seo.ts
--- a/src/lib/seo.ts
+++ b/src/lib/seo.ts
@@ -0,0 +1,77 @@
+import type { Metadata } from "next";
+
+/**
+ * Launch SEO settings. One place for the production origin, the indexable
+ * route list, and the per-page canonical + Open Graph helper.
+ *
+ * The same deployment answers on www.im.agency and on *.vercel.app, so
+ * canonicals, the sitemap, and robots always name the production origin.
+ */
+export const PRODUCTION_HOST = "www.im.agency";
+export const SITE_URL = `https://${PRODUCTION_HOST}`;
+export const GA_MEASUREMENT_ID = "G-FTJBL1NS13";
+
+/**
+ * Final 200 URLs only (never a redirect source such as /results or /about-us).
+ * Mirrors the route list in scripts/verify-routes.mjs. Update both together.
+ */
+export const INDEXABLE_ROUTES = [
+  "/",
+  "/new-to-tv",
+  "/ctv",
+  "/converged-tv",
+  "/established-brands",
+  "/measurement",
+  "/creative",
+  "/partnerships",
+  "/about",
+  "/contact",
+  "/insights",
+  "/insights/premium",
+  "/insights/targeting",
+  "/insights/attribution",
+  "/insights/scale",
+  "/insights/intelligence",
+] as const;
+
+export function isProductionHost(host: string | null | undefined) {
+  return (host ?? "").toLowerCase().split(":")[0] === PRODUCTION_HOST;
+}
+
+/** Shared Open Graph fields. Pages that set openGraph replace the parent object, so every page spreads these. */
+export const openGraphDefaults = {
+  type: "website",
+  siteName: "InterMedia Advertising",
+  locale: "en_US",
+  images: [
+    {
+      url: "/video/reel-poster.jpg",
+      width: 1920,
+      height: 1080,
+      alt: "InterMedia Advertising",
+    },
+  ],
+} satisfies Metadata["openGraph"];
+
+/**
+ * Wrap a page's existing metadata with a self-canonical and matching Open Graph tags.
+ * `path` is the page's own final URL path, e.g. "/converged-tv".
+ */
+export function withSeo(path: string, metadata: Metadata): Metadata {
+  const title =
+    typeof metadata.title === "string"
+      ? metadata.title
+      : metadata.title && "absolute" in metadata.title
+        ? metadata.title.absolute
+        : undefined;
+  return {
+    ...metadata,
+    alternates: { canonical: path },
+    openGraph: {
+      ...openGraphDefaults,
+      url: path,
+      ...(title ? { title } : {}),
+      ...(metadata.description ? { description: metadata.description } : {}),
+    },
+  };
+}
